<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(MSBuildProjectDirectory)/../.sdk/</DalamudLibPath>
    <AssemblySearchPaths>$(DalamudLibPath);{CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <Version>0.6.0</Version>
    <Authors>CrescentCompass contributors</Authors>
    <Description>新月島蘿蔔偵測、寶箱巡查路線與地圖旗標</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CrescentCompass.Core/CrescentCompass.Core.csproj" />
    <EmbeddedResource Include="Data/**/*.json" />
  </ItemGroup>
  <Target Name="VerifyDalamud" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')" Text="Set DALAMUD_HOME to an API 13 SDK directory, or place reference DLLs in .sdk/." />
    <GetAssemblyIdentity AssemblyFiles="$(DalamudLibPath)/Dalamud.dll">
      <Output TaskParameter="Assemblies" ItemName="DalamudIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="$([MSBuild]::VersionLessThan('%(DalamudIdentity.Version)', '13.0')) Or $([MSBuild]::VersionGreaterThanOrEquals('%(DalamudIdentity.Version)', '14.0'))" Text="This build targets Dalamud API 13. Use a matching SDK." />
  </Target>
</Project>
